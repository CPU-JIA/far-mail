# ============================================================
# FAR Mail 环境变量模板
# 复制为 .env 并填写实际值：cp .env.example .env
# ============================================================
#
# ╔══════════════════════════════════════════════════════════════════╗
# ║  端口修改总指南                                                   ║
# ╠══════════════╦═══════════════════════════════════════════════════╣
# ║ 修改 Web 端口 ║ docker-compose.yml → frontend.ports 左边数字      ║
# ╠══════════════╬═══════════════════════════════════════════════════╣
# ║ 修改 API 端口 ║ 1. 本文件 API_PORT=xxxx                           ║
# ║ (容器内 8080) ║ 2. 本文件 API_DB_DSN 中 @pgbouncer:6432 不要动    ║
# ║              ║ 3. docker-compose.yml api.ports 右边改成 xxxx      ║
# ║              ║ 4. 外部反代与 postfix/entrypoint.sh 同步修改       ║
# ╠══════════════╬═══════════════════════════════════════════════════╣
# ║ 修改 SMTP 端口║ 仅改 docker-compose.yml postfix.ports 左边数字    ║
# ║ (容器内 25)   ║ 注意：外部 MX 投信必须用 25，改端口只影响本地测试  ║
# ╚══════════════╩═══════════════════════════════════════════════════╝

# ---------- PostgreSQL ----------
POSTGRES_DB=far_mail
POSTGRES_USER=far_mail
POSTGRES_PASSWORD=change_me_strong_password

# ---------- Redis ----------
REDIS_PASSWORD=change_me_redis_password

# ---------- API Server ----------
# Docker build dependency mirrors. Override them when your network uses another mirror.
GOPROXY=https://goproxy.cn,direct
NPM_REGISTRY=https://registry.npmmirror.com

# ★ API_PORT：Go API 容器内监听的端口，默认 8080。
# 修改此值后，必须同步修改以下位置，否则反代和 Postfix 无法找到 API：
#   - docker-compose.yml：api.ports 右边数字改成一样的值
#   - 用户自己的 Nginx/Caddy：API upstream 容器端口改成一样的值
#   - postfix/entrypoint.sh：curl http://api:8080 中的 8080
API_PORT=8080
# ★ API_DB_DSN：数据库连接串，@pgbouncer:6432 是容器内部地址，不要改。
# 只需要把 change_me_strong_password 改成和 POSTGRES_PASSWORD 一样的值。
API_DB_DSN=postgres://far_mail:change_me_strong_password@pgbouncer:6432/far_mail?sslmode=disable
# ★ API_REDIS_ADDR：Redis 容器内部地址，redis:6379 不要改（容器间内网通信）。
API_REDIS_ADDR=redis:6379
# ★ API_REDIS_PASSWORD：改成和 REDIS_PASSWORD 一样的值。
API_REDIS_PASSWORD=change_me_redis_password
# API_RATE_LIMIT 和 API_RATE_WINDOW：API 速率限制，默认 500 次/分钟。
API_RATE_LIMIT=500
API_RATE_WINDOW=60
# Browser origin allowed to call the owner console. Keep this exact in production.
CONSOLE_ORIGIN=http://localhost:8889
# Browser-visible API origin. Local direct access uses the host API port.
# Set this to an empty value when Nginx/Caddy routes API paths on the same origin.
PUBLIC_API_ORIGIN=http://127.0.0.1:18081
# Stable Docker network used only by frontend, API, and an optional edge proxy.
EDGE_NETWORK_NAME=far-mail-edge
# Comma-separated CIDRs for reverse proxies whose X-Forwarded-For header is trusted.
# Docker bridge networks are covered by the default private-network range.
TRUSTED_PROXY_CIDRS=172.16.0.0/12
# Private API/Postfix domain sync credential; required and never exposed to the browser.
# Generate with: openssl rand -hex 32
INTERNAL_SYNC_KEY=replace_with_64_hex_characters

# ---------- Integrations ----------
# Optional. Leave empty to configure the Cloudflare Token in the owner console.
# Recommended permission scope: Zone:Read and Zone:DNS:Edit for selected zones only.
CLOUDFLARE_API_TOKEN=

# ---------- 后台任务 ----------
DISABLE_CLEANUP_LOOP=false
DISABLE_DOMAIN_HEALTH_LOOP=false
DISABLE_MX_VERIFIER_LOOP=false
AUTO_CLEAN_INTERVAL_SECONDS=60
AUTO_CLEAN_EMAIL_MAX_AGE_MINUTES=1440
AUTO_CLEAN_EMAIL_MAX_COUNT=30000

# ---------- SMTP / Mail ----------
# 服务器公网 IP，用于 MX 验证与 SPF 生成
SMTP_SERVER_IP=192.0.2.10
# 邮件服务器主机名（如 mail.yourdomain.com）。
# 设置后用户添加域名仅需一条 MX 记录，无需额外 A 记录。
SMTP_HOSTNAME=mail.yourdomain.com

# ---------- Go LMTP Ingress ----------
# LMTP_ADDR 只在 Docker internal network 内供 Postfix 访问，不需要对外暴露。
LMTP_ADDR=0.0.0.0:2527
INGRESS_WORKERS=48
INGRESS_QUEUE_SIZE=2048
INGRESS_DELIVERY_TIMEOUT_SECONDS=8
INGRESS_BODY_MAX_BYTES=262144
INGRESS_STORE_BODY_MAX_BYTES=65536
INGRESS_CACHE_REFRESH_SECONDS=30

# ---------- Postfix LMTP 调度 ----------
POSTFIX_LMTP_DESTINATION_CONCURRENCY_LIMIT=100
POSTFIX_DEFAULT_DESTINATION_CONCURRENCY_LIMIT=120
POSTFIX_LMTP_CONNECTION_CACHE_DESTINATIONS=static:all
POSTFIX_LMTP_CONNECTION_CACHE_TIME_LIMIT=30s
POSTFIX_CONNECTION_CACHE_TTL_LIMIT=30s
