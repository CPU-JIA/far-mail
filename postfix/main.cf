# ============================================================
# Postfix 主配置 - 仅收件模式 (catch-all)
# ============================================================
smtpd_banner = $myhostname ESMTP
compatibility_level = 3.11
biff = no
append_dot_mydomain = no

# TLS (基础)
smtpd_tls_security_level = none

# 基本设置
myhostname = mail.example.com
mydomain = example.com
myorigin = $mydomain
inet_interfaces = all
inet_protocols = ipv4

# 只收件，不中继
mydestination =
relay_domains =
local_transport = error:local delivery disabled
local_recipient_maps =

# 虚拟域名 catch-all（支持无限子域）
virtual_mailbox_domains = regexp:/etc/postfix/virtual_domains.regexp
virtual_transport = lmtp:inet:api:2527

# 限制
smtpd_recipient_restrictions =
    permit_mynetworks,
    reject_unauth_destination

# 性能优化
smtpd_client_connection_count_limit = 0
smtpd_client_connection_rate_limit = 0
default_process_limit = 96
bounce_queue_lifetime = 1h
maximal_queue_lifetime = 1h
message_size_limit = 10240000
smtpd_timeout = 300s

# 并发
smtp_destination_concurrency_limit = 20
lmtp_destination_recipient_limit = 1
lmtp_destination_concurrency_limit = 100
default_destination_concurrency_limit = 120
lmtp_connection_cache_destinations = static:all
lmtp_connection_cache_time_limit = 30s
connection_cache_ttl_limit = 30s

in_flow_delay = 0s
minimal_backoff_time = 10s
maximal_backoff_time = 60s
queue_run_delay = 10s

import_environment = MAIL_CONFIG MAIL_DEBUG MAIL_LOGTAG TZ XAUTHORITY DISPLAY LANG=C POSTLOG_SERVICE POSTLOG_HOSTNAME SMTP_HOSTNAME
export_environment = TZ MAIL_CONFIG LANG SMTP_HOSTNAME
